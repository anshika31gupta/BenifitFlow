# Frontend environment variables
# Copy this file to .env.local or .env before running the app locally.

# GEMINI_API_KEY: Optional API key for live Gemini AI responses.
GEMINI_API_KEY=""

# APP_URL: The URL where this frontend is hosted.
APP_URL="http://localhost:3001"

# VITE_API_URL: Base URL of the BenefitFlow backend REST API.
# For local development, use the backend URL without the /api suffix because the frontend server proxies it.
VITE_API_URL="http://localhost:4000"
